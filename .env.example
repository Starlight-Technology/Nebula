OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_PORT=11434

MONGODB_PORT=27017
MONGODB_PASSWORD=password

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=nebula

# Web local-first auth. Generate with: openssl rand -hex 32
NEBULA_WEB_AUTH_TOKEN=
# Bind the web port to loopback by default. Change only with auth/HTTPS in place.
NEBULA_WEB_BIND=127.0.0.1
NEBULA_WEB_PORT=8081

SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://localhost:8080/
# Optional: set for stable sessions if the instance is exposed beyond local use.
# SEARXNG_SECRET=

WebResearch__Provider=Free
WebResearch__MaxResults=10
WebResearch__TimeoutSeconds=20

Research__SearXng__Enabled=true
Research__SearXng__BaseUrl=http://searxng:8080
Research__SearXng__MaxResults=10
Research__SearXng__TimeoutSeconds=20

Nebula__MaxActionSteps=15
Nebula__MaxActionRetries=6
# 0 disables the timeout. Local builds/tests/commands can run indefinitely.
Nebula__CommandTimeoutSeconds=0
Nebula__ScriptTimeoutSeconds=0
Nebula__MaxConsecutiveErrorRetries=3
Nebula__EnableResultValidation=true
Nebula__EnableEnvironmentValidation=true
# MAUI only: background Postgres initialization retry/backoff.
NEBULA_DB_INIT_MAX_ATTEMPTS=5
NEBULA_DB_INIT_INITIAL_DELAY_MS=1000
NEBULA_DB_INIT_MAX_DELAY_MS=30000
# Server sandbox floor/initial mode. The UI can opt in when Disabled, but
# Conservative/Standard profiles cannot disable a Docker floor.
Nebula__Sandbox__Mode=Disabled
# Auto prefers docker, then podman. Use Docker or Podman to force one runtime.
Nebula__Sandbox__Runtime=Auto
Nebula__Sandbox__Image=mcr.microsoft.com/powershell:lts
Nebula__Sandbox__MemoryLimitMb=0
Nebula__Sandbox__CpuLimit=0
# Optional sidecar mode (docker-compose.sandbox.yml). Set a long random value.
NEBULA_SANDBOX_TOKEN=change-me
# Use Docker by setting runtime/socket and the user/userns/security overrides
# below to 0:0, host, and label=disable.
NEBULA_SANDBOX_RUNTIME=Podman
NEBULA_SANDBOX_SOCKET=/run/user/1000/podman/podman.sock
NEBULA_SANDBOX_USER=1000:1000
NEBULA_SANDBOX_USERNS_MODE=keep-id
NEBULA_SANDBOX_SECURITY_OPT=label=type:container_runtime_t
# Nebula__Sandbox__SidecarUrl=http://nebula-sandbox:8091
# Nebula__Sandbox__SidecarToken=change-me

# Pull Request tokens are server-side only; never expose them in the browser.
# Nebula__PullRequest__GitHubToken=
# Nebula__PullRequest__GitLabToken=
# Nebula__PullRequest__GitLabProjectId=
Nebula__PullRequest__DefaultTargetBranch=main
Nebula__PullRequest__PushBranchIfNeeded=true
