OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_PORT=11434

MONGODB_PORT=27017
MONGODB_PASSWORD=password

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=nebula

SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://localhost:8080/
# Optional: set for stable sessions if the instance is exposed beyond local use.
# SEARXNG_SECRET=

WebResearch__Provider=Free
WebResearch__MaxResults=10
WebResearch__TimeoutSeconds=20

Research__SearXng__Enabled=true
Research__SearXng__BaseUrl=http://searxng:8080
Research__SearXng__MaxResults=10
Research__SearXng__TimeoutSeconds=20

Nebula__MaxActionSteps=15
Nebula__MaxActionRetries=6
Nebula__CommandTimeoutSeconds=300
Nebula__ScriptTimeoutSeconds=300
Nebula__LlmTimeoutSeconds=60000
Nebula__MaxConsecutiveErrorRetries=3
Nebula__EnableResultValidation=true
Nebula__EnableEnvironmentValidation=true
