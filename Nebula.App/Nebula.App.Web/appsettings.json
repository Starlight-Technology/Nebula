{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WebResearch": {
    "Provider": "Free",
    "ApiKey": "",
    "MaxResults": 10,
    "TimeoutSeconds": 20,
    "CacheDays": 7,
    "RateLimitMilliseconds": 1000
  },
  "Research": {
    "SearXng": {
      "Enabled": true,
      "BaseUrl": "http://localhost:8080",
      "MaxResults": 10,
      "TimeoutSeconds": 20,
      "Language": "pt-BR",
      "SafeSearch": 1
    }
  },
  "Nebula": {
    "ResponseLanguageCode": "pt-BR",
    "ResponseLanguageName": "Portugues (Brasil)",
    "CommandSafety": {
      "FallbackModelPath": "models/command-safety-classifier.zip"
    }
  },
  "AllowedHosts": "*"
}
