@using Corona.Components
@using Corona.Components.Enums
@using Corona.Components.Iconography
@using Corona.Components.Models
@using Corona.Theming
@inherits LayoutComponentBase
@implements IDisposable
@inject ILlamaRuntimeTelemetryService RuntimeTelemetryService
@inject CoronaThemeProvider ThemeProvider

<CoronaThemeCascadingValue>
    <CoronaLayoutShell DrawerTitle="Nebula"
                       HeaderTitle="Nebula"
                       DrawerWidthPx="320"
                       DrawerOverlay="true"
                       ShowMenuButton="true"
                       MenuIcon="@CoronaIcons.Cogs"
                       HeaderActions="@HeaderActions"
                       DrawerOpen="false"
                       DrawerItens="itemsMenu">
        @Body
    </CoronaLayoutShell>
</CoronaThemeCascadingValue>

@code {
    private List<CoronaNavItem> itemsMenu = [];
    private readonly CancellationTokenSource telemetryCancellation = new();
    private LlamaRuntimeTelemetrySnapshot runtimeTelemetry = new();

    private RenderFragment HeaderActions =>
        @<CoronaStack Direction="CoronaStackDirection.Row"
                      Wrap="CoronaStackWrap.Wrap"
                      Align="CoronaStackAlign.Center"
                      Spacing=".5rem"
                      Class="nebula-header-actions">
            <span title="@runtimeTelemetry.StatusDetail" class="nebula-header-metric nebula-header-metric--status">
                <CoronaBadge Content="@runtimeTelemetry.StatusLabel"
                             Variant="CoronaBadgeVariant.Soft"
                             Color="@GetStatusColor()" />
            </span>

            <span title="@runtimeTelemetry.RuntimeModeDetail" class="nebula-header-metric nebula-header-metric--mode">
                <CoronaBadge Content="@runtimeTelemetry.RuntimeModeLabel"
                             Variant="CoronaBadgeVariant.Outlined"
                             Color="@GetRuntimeModeColor()" />
            </span>

            <span title="@runtimeTelemetry.Cpu.DetailValue" class="nebula-header-metric nebula-header-metric--cpu">
                <CoronaBadge Content="@($"CPU {runtimeTelemetry.Cpu.ShortValue}")"
                             Variant="CoronaBadgeVariant.Outlined"
                             Color="@GetMetricColor(runtimeTelemetry.Cpu)" />
            </span>

            <span title="@runtimeTelemetry.Memory.DetailValue" class="nebula-header-metric nebula-header-metric--memory">
                <CoronaBadge Content="@($"RAM {runtimeTelemetry.Memory.ShortValue}")"
                             Variant="CoronaBadgeVariant.Outlined"
                             Color="@GetMetricColor(runtimeTelemetry.Memory)" />
            </span>

            <span title="@runtimeTelemetry.Gpu.DetailValue" class="nebula-header-metric nebula-header-metric--gpu">
                <CoronaBadge Content="@($"GPU {runtimeTelemetry.Gpu.ShortValue}")"
                             Variant="CoronaBadgeVariant.Outlined"
                             Color="@GetMetricColor(runtimeTelemetry.Gpu)" />
            </span>

            <CoronaButton Size="CoronaComponentSize.Small"
                          Variant="CoronaButtonVariant.Outlined"
                          Color="CoronaColorSemantic.Neutral"
                          Class="nebula-header-theme-toggle"
                          OnClick="ToggleTheme">
                @(ThemeProvider.CurrentTheme.Mode == CoronaThemeMode.Dark ? "Tema claro" : "Tema escuro")
            </CoronaButton>
        </CoronaStack>;

    protected override void OnInitialized()
    {
        ThemeProvider.OnChange += HandleThemeChanged;

        itemsMenu =
        [
            new CoronaNavItem
            {
                Text = "Painel",
                Url = "/",
                Icon = CoronaIcons.House
            },
            new CoronaNavItem
            {
                Text = "Conversa",
                Url = "/chat",
                Icon = "comments"
            },
            new CoronaNavItem
            {
                Text = "Modelos",
                Url = "/models",
                Icon = "layer-group"
            },
            new CoronaNavItem
            {
                Text = "Runtime",
                Url = "/runtime",
                Icon = CoronaIcons.Cogs
            }
        ];
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = StartTelemetryLoopAsync(telemetryCancellation.Token);
        }

        return Task.CompletedTask;
    }

    private async Task StartTelemetryLoopAsync(CancellationToken cancellationToken)
    {
        await RefreshTelemetryAsync(cancellationToken);

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTelemetryAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Encerramento normal do layout.
        }
    }

    private async Task RefreshTelemetryAsync(CancellationToken cancellationToken)
    {
        try
        {
            runtimeTelemetry = await RuntimeTelemetryService.GetSnapshotAsync(cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Encerramento normal do layout.
        }
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private Task ToggleTheme()
    {
        ThemeProvider.ToggleTheme();
        return Task.CompletedTask;
    }

    private CoronaColorSemantic GetStatusColor()
    {
        return runtimeTelemetry.IsAvailable
            ? CoronaColorSemantic.Success
            : CoronaColorSemantic.Warning;
    }

    private CoronaColorSemantic GetRuntimeModeColor()
    {
        return runtimeTelemetry.RuntimeModeLabel switch
        {
            "NVIDIA CUDA" => CoronaColorSemantic.Success,
            "AMD ROCm" => CoronaColorSemantic.Warning,
            "Intel Vulkan" => CoronaColorSemantic.Warning,
            _ => CoronaColorSemantic.Neutral
        };
    }

    private static CoronaColorSemantic GetMetricColor(LlamaRuntimeMetric metric)
    {
        if (!metric.IsAvailable)
        {
            return CoronaColorSemantic.Neutral;
        }

        if (metric.Percent is null)
        {
            return CoronaColorSemantic.Primary;
        }

        return metric.Percent.Value switch
        {
            >= 85 => CoronaColorSemantic.Danger,
            >= 65 => CoronaColorSemantic.Warning,
            _ => CoronaColorSemantic.Success
        };
    }

    public void Dispose()
    {
        telemetryCancellation.Cancel();
        telemetryCancellation.Dispose();
        ThemeProvider.OnChange -= HandleThemeChanged;
    }
}
