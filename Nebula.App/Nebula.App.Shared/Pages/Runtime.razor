@page "/runtime"
@implements IDisposable
@using System.Globalization
@using Nebula.Core.Telemetry
@inject NebulaWorkspaceState WorkspaceState
@inject ILlamaRuntimeTelemetryService RuntimeTelemetryService
@inject NavigationManager NavigationManager

<CoronaContainer MaxWidth="CoronaContainerMaxWidth.Xl" Class="nebula-page-shell">
    <section class="nebula-screen-header">
        <div>
            <CoronaStack Direction="CoronaStackDirection.Row" Wrap="CoronaStackWrap.Wrap" Spacing=".5rem">
                <CoronaBadge Content="Runtime" Variant="CoronaBadgeVariant.Soft" />
                <CoronaBadge Content="@WorkspaceState.GetAccelerationStatusText()"
                             Variant="CoronaBadgeVariant.Outlined"
                             Color="@WorkspaceState.GetRecommendationColor()" />
            </CoronaStack>
            <h2>Setup e aceleracao</h2>
            <p>Leitura do ambiente, perfil recomendado e comandos Docker para o backend local.</p>
        </div>

        <CoronaStack Direction="CoronaStackDirection.Row" Wrap="CoronaStackWrap.Wrap" Spacing=".75rem">
            <CoronaButton Variant="CoronaButtonVariant.Outlined"
                          Color="CoronaColorSemantic.Neutral"
                          Icon="@CoronaIcons.ArrowLeft"
                          OnClick="NavigateToModels">
                Modelos
            </CoronaButton>

            <CoronaButton Variant="CoronaButtonVariant.Outlined"
                          Color="CoronaColorSemantic.Neutral"
                          Icon="@CoronaIcons.Clock"
                          Disabled="@WorkspaceState.IsDetectingEnvironment"
                          Loading="@WorkspaceState.IsDetectingEnvironment"
                          OnClick="WorkspaceState.DetectEnvironmentAsync">
                Redetectar
            </CoronaButton>
        </CoronaStack>
    </section>

    <div class="nebula-runtime-layout">
        <CoronaCard Class="nebula-status-card">
            <div class="nebula-status-card__header">
                <div>
                    <p class="nebula-kicker">Estado da central</p>
                    <h3>Runtime local</h3>
                </div>

                <CoronaBadge Content="@(WorkspaceState.IsRuntimeOnline ? "Online" : "Offline")"
                             Variant="CoronaBadgeVariant.Soft"
                             Color="@(WorkspaceState.IsRuntimeOnline ? CoronaColorSemantic.Success : CoronaColorSemantic.Warning)" />
            </div>

            <div class="nebula-status-list nebula-status-list--grid">
                <div class="nebula-status-row">
                    <span>Modelo ativo</span>
                    <strong>@WorkspaceState.ActiveModelName</strong>
                </div>
                <div class="nebula-status-row">
                    <span>Modelos instalados</span>
                    <strong>@WorkspaceState.InstalledModelCount catalogado(s)</strong>
                </div>
                <div class="nebula-status-row">
                    <span>Endpoint do modelo</span>
                    <code>@WorkspaceState.LlamaUrl</code>
                </div>
                <div class="nebula-status-row">
                    <span>Host do agente</span>
                    <strong>@WorkspaceState.GetHostSummary()</strong>
                </div>
                <div class="nebula-status-row">
                    <span>Shell da UI</span>
                    <strong>@WorkspaceState.GetClientShellSummary()</strong>
                </div>
                <div class="nebula-status-row">
                    <span>Aceleracao recomendada</span>
                    <strong>@WorkspaceState.GetAccelerationStatusText()</strong>
                </div>
            </div>
        </CoronaCard>

        <section class="nebula-runtime-main">
            <CoronaCard Class="nebula-status-card">
                <div class="nebula-status-card__header">
                    <div>
                        <p class="nebula-kicker">Hardware do host</p>
                        <h3>CPU, memoria, disco e GPU</h3>
                    </div>

                    <CoronaStack Direction="CoronaStackDirection.Row" Wrap="CoronaStackWrap.Wrap" Spacing=".5rem">
                        <CoronaBadge Content="@($"Fonte {runtimeTelemetry.MetricsSource}")"
                                     Variant="CoronaBadgeVariant.Soft"
                                     Color="CoronaColorSemantic.Neutral" />
                        @if (runtimeTelemetry.Hardware is { } hardware)
                        {
                            <CoronaBadge Content="@hardware.Source"
                                         Variant="CoronaBadgeVariant.Outlined"
                                         Color="CoronaColorSemantic.Neutral" />
                        }
                    </CoronaStack>
                </div>

                @if (runtimeTelemetry.Hardware is not { } hardware)
                {
                    <div class="nebula-pending-panel">
                        <div class="nebula-pending-panel__pulse"></div>
                        <div>
                            <p class="nebula-pending-panel__title">Lendo hardware do host...</p>
                            <p>O sidecar de telemetria fornece CPU, memoria, disco e GPU sem depender do container da aplicacao.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="nebula-status-list nebula-status-list--grid">
                        <div class="nebula-status-row">
                            <span>CPU</span>
                            <strong>@hardware.Cpu.Detail</strong>
                        </div>
                        <div class="nebula-status-row">
                            <span>Uso de CPU</span>
                            <strong>@FormatPercent(hardware.Cpu.UsagePercent)</strong>
                        </div>
                        <div class="nebula-status-row">
                            <span>Memoria</span>
                            <strong>@hardware.Memory.Detail</strong>
                        </div>
                        <div class="nebula-status-row">
                            <span>Uso de memoria</span>
                            <strong>@FormatPercent(hardware.Memory.UsagePercent)</strong>
                        </div>

                        @if (GetPrimaryDisk() is { } disk)
                        {
                            <div class="nebula-status-row">
                                <span>Disco principal</span>
                                <strong>@($"{disk.Name} | {FormatBytes(disk.UsedBytes)} de {FormatBytes(disk.TotalBytes)} ({FormatPercent(disk.UsagePercent)})")</strong>
                            </div>
                            <div class="nebula-status-row">
                                <span>Espaco livre</span>
                                <strong>@($"{FormatBytes(disk.FreeBytes)} livres em {disk.MountPoint}")</strong>
                            </div>
                        }

                        @if (runtimeTelemetry.Gpus.Count == 0)
                        {
                            <div class="nebula-status-row">
                                <span>GPU</span>
                                <strong>Nenhuma GPU visivel no host</strong>
                            </div>
                        }
                        else
                        {
                            @foreach (var gpu in runtimeTelemetry.Gpus)
                            {
                                <div class="nebula-status-row">
                                    <span>@gpu.Name</span>
                                    <strong>@($"{GetVendorLabel(gpu)} | uso {FormatPercent(gpu.UtilizationPercent)} | VRAM {FormatBytes(gpu.MemoryUsedBytes)} / {FormatBytes(gpu.MemoryTotalBytes)}")</strong>
                                </div>
                            }
                        }
                    </div>

                    @if (hardware.Warnings.Count > 0)
                    {
                        <div class="nebula-warning-panel" style="margin-top: .75rem;">
                            <div>
                                <p class="nebula-warning-panel__title">Alertas da leitura de hardware</p>
                                <ul class="nebula-setup-list nebula-setup-list--compact">
                                    @foreach (var warning in hardware.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                }
            </CoronaCard>

            @if (WorkspaceState.IsDetectingEnvironment && WorkspaceState.SetupRecommendation is null)
            {
                <div class="nebula-pending-panel">
                    <div class="nebula-pending-panel__pulse"></div>
                    <div>
                        <p class="nebula-pending-panel__title">Analisando o ambiente local...</p>
                        <p>A recomendacao combina sinais do host, shell da UI e endpoint do Ollama.</p>
                    </div>
                </div>
            }
            else if (WorkspaceState.SetupRecommendation is not null)
            {
                <CoronaCard Class="@GetSetupCardClass()">
                    <div class="nebula-setup-card__eyebrow">
                        <CoronaBadge Content="Setup guiado" Variant="CoronaBadgeVariant.Soft" />
                        <CoronaBadge Content="@WorkspaceState.SetupRecommendation.ProfileName"
                                     Variant="CoronaBadgeVariant.Outlined"
                                     Color="@WorkspaceState.GetRecommendationColor()" />
                        <CoronaBadge Content="@($"Confianca {WorkspaceState.SetupRecommendation.ConfidenceLabel}")"
                                     Variant="CoronaBadgeVariant.Outlined"
                                     Color="@WorkspaceState.GetConfidenceColor()" />

                        @if (WorkspaceState.SetupRecommendation.IsExperimental)
                        {
                            <CoronaBadge Content="Experimental"
                                         Variant="CoronaBadgeVariant.Soft"
                                         Color="CoronaColorSemantic.Warning" />
                        }
                    </div>

                    <div class="nebula-setup-card__content">
                        <div>
                            <h3>@WorkspaceState.SetupRecommendation.Summary</h3>
                            <p>@WorkspaceState.SetupRecommendation.ModelHint</p>
                        </div>

                        <code class="nebula-setup-card__command">@WorkspaceState.SetupRecommendation.Command</code>
                    </div>

                    <div class="nebula-setup-facts">
                        <div class="nebula-setup-fact">
                            <span>Host do agente</span>
                            <strong>@WorkspaceState.GetHostSummary()</strong>
                        </div>

                        <div class="nebula-setup-fact">
                            <span>Shell da UI</span>
                            <strong>@WorkspaceState.GetClientShellSummary()</strong>
                        </div>

                        <div class="nebula-setup-fact">
                            <span>Pista de GPU</span>
                            <strong>@WorkspaceState.SetupRecommendation.GpuLabel</strong>
                        </div>

                        <div class="nebula-setup-fact">
                            <span>Runtime Ollama</span>
                            <strong>@WorkspaceState.GetRuntimeScopeSummary()</strong>
                        </div>
                    </div>

                    <div class="nebula-setup-columns">
                        <div class="nebula-setup-column">
                            <p class="nebula-setup-column__title">Por que essa sugestao</p>
                            <ul class="nebula-setup-list">
                                @foreach (var reason in WorkspaceState.SetupRecommendation.Reasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        </div>

                        <div class="nebula-setup-column">
                            <p class="nebula-setup-column__title">Proximos passos</p>
                            <ul class="nebula-setup-list">
                                @foreach (var step in WorkspaceState.SetupRecommendation.NextSteps)
                                {
                                    <li>@step</li>
                                }
                            </ul>
                        </div>
                    </div>
                </CoronaCard>

                @if (!string.IsNullOrWhiteSpace(WorkspaceState.EnvironmentDetectionError))
                {
                    <div class="nebula-warning-panel">
                        <div>
                            <p class="nebula-warning-panel__title">Leitura parcial do shell</p>
                            <p>@WorkspaceState.EnvironmentDetectionError</p>
                        </div>
                    </div>
                }

                @if (WorkspaceState.SetupRecommendation.Warnings.Count > 0)
                {
                    <div class="nebula-warning-panel">
                        <div>
                            <p class="nebula-warning-panel__title">Alertas do assistente</p>
                            <ul class="nebula-setup-list nebula-setup-list--compact">
                                @foreach (var warning in WorkspaceState.SetupRecommendation.Warnings)
                                {
                                    <li>@warning</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }

            <section class="nebula-model-section">
                <div class="nebula-section-title">
                    <h3>Perfis de aceleracao</h3>
                    <p>O backend de GPU e definido pelo runtime do Ollama.</p>
                </div>

                <div class="nebula-acceleration-grid">
                    @foreach (var profile in WorkspaceState.AccelerationProfiles)
                    {
                        <div class="@WorkspaceState.GetAccelerationCardClass(profile)">
                            <div class="nebula-acceleration-card__header">
                                <div class="nebula-acceleration-card__labels">
                                    <strong>@profile.Name</strong>

                                    @if (WorkspaceState.IsRecommendedProfile(profile))
                                    {
                                        <span class="nebula-acceleration-card__flag">Recomendado agora</span>
                                    }
                                </div>

                                <CoronaBadge Content="@WorkspaceState.GetAccelerationBadge(profile)"
                                             Variant="CoronaBadgeVariant.Outlined"
                                             Color="@WorkspaceState.GetAccelerationBadgeColor(profile)" />
                            </div>

                            <p>@profile.Description</p>
                            <code>@profile.Command</code>
                        </div>
                    }
                </div>
            </section>
        </section>
    </div>
</CoronaContainer>

@code {
    private readonly CancellationTokenSource telemetryCancellation = new();
    private LlamaRuntimeTelemetrySnapshot runtimeTelemetry = new();

    protected override void OnInitialized()
    {
        WorkspaceState.Changed += HandleWorkspaceChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await WorkspaceState.EnsureRuntimeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = StartTelemetryLoopAsync(telemetryCancellation.Token);
            await WorkspaceState.DetectEnvironmentAsync();
        }
    }

    private async Task StartTelemetryLoopAsync(CancellationToken cancellationToken)
    {
        await RefreshTelemetryAsync(cancellationToken);

        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTelemetryAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Encerramento normal da pagina.
        }
    }

    private async Task RefreshTelemetryAsync(CancellationToken cancellationToken)
    {
        try
        {
            runtimeTelemetry = await RuntimeTelemetryService.GetSnapshotAsync(cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Encerramento normal da pagina.
        }
    }

    private void NavigateToModels()
    {
        NavigationManager.NavigateTo("/models");
    }

    private string GetSetupCardClass()
    {
        return WorkspaceState.SetupRecommendation?.UsesGpu == true
            ? "nebula-setup-card is-gpu"
            : "nebula-setup-card is-cpu";
    }

    private HostDiskTelemetry? GetPrimaryDisk()
    {
        var disks = runtimeTelemetry.Hardware?.Disks;
        return disks?.FirstOrDefault(disk => disk.IsHost) ?? disks?.FirstOrDefault();
    }

    private static string GetVendorLabel(HostGpuTelemetry gpu)
    {
        return string.IsNullOrWhiteSpace(gpu.Vendor)
            ? "GPU"
            : gpu.Vendor.ToUpperInvariant();
    }

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null)
        {
            return "--";
        }

        var value = bytes.Value;
        var absolute = Math.Abs((double)value);
        if (absolute >= 1024d * 1024d * 1024d)
        {
            return string.Create(CultureInfo.InvariantCulture, $"{value / (1024d * 1024d * 1024d):0.0} GiB");
        }

        if (absolute >= 1024d * 1024d)
        {
            return string.Create(CultureInfo.InvariantCulture, $"{value / (1024d * 1024d):0.#} MiB");
        }

        if (absolute >= 1024d)
        {
            return string.Create(CultureInfo.InvariantCulture, $"{value / 1024d:0.#} KiB");
        }

        return string.Create(CultureInfo.InvariantCulture, $"{value:0} B");
    }

    private static string FormatPercent(double? value)
    {
        return value is null
            ? "--"
            : string.Create(CultureInfo.InvariantCulture, $"{value.Value:0.#}%");
    }

    private void HandleWorkspaceChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        telemetryCancellation.Cancel();
        telemetryCancellation.Dispose();
        WorkspaceState.Changed -= HandleWorkspaceChanged;
    }
}
